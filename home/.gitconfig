[core]
    pager = less -FRX
    autocrlf = input
    excludesFile = ~/.config/git/ignore
[init]
    defaultBranch = main
[pull]
    rebase = true
[rebase]
    autoSquash = true
[rerere]
    enabled = true
    autoupdate = false
[push]
    default = current
    autoSetupRemote = true
[fetch]
    prune = true
[diff]
    colorMoved = default
    algorithm = histogram
[merge]
    conflictstyle = zdiff3
[color]
    ui = auto
[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
[include]
    path = ~/.gitconfig.local
